{
 "uid": "gasvirtual",
 "title": "GasVirtual · Monitoreo del pronóstico",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Salud del modelo",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "WAPE diario por estación (última semana evaluada)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gasvirtual_wape_diario",
     "legendFormat": "{{estacion}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Sesgo por estación (negativo = subestima → riesgo de desabastecimiento)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
